<div class="flex flex-col h-screen bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-gray-200 px-6 py-4">
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-900">Support Chat</h1>
      <div class="flex items-center space-x-4">
        <%= link_to "Knowledge Base", documents_path, class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
        <span class="text-sm text-gray-500">Chatting as <%= current_user.email %></span>
      </div>
    </div>
  </header>

  <!-- Messages Area -->
  <div id="messages-container" class="flex-1 overflow-y-auto px-6 py-4 space-y-4">
    <% if @messages.empty? %>
      <div class="flex items-center justify-center h-full">
        <div class="text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No messages yet</h3>
          <p class="mt-1 text-sm text-gray-500">Start a conversation by asking a question below.</p>
        </div>
      </div>
    <% else %>
      <% @messages.each do |message| %>
        <div class="flex <%= message.role == 'user' ? 'justify-end' : 'justify-start' %>">
          <div class="max-w-3xl <%= message.role == 'user' ? 'bg-blue-600 text-white' : 'bg-white text-gray-900 border border-gray-200' %> rounded-lg px-4 py-3 shadow-sm">
            <% if message.role == 'assistant' %>
              <div class="flex items-start space-x-2">
                <svg class="h-5 w-5 text-blue-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd" />
                </svg>
                <div class="flex-1">
                  <p class="text-sm font-medium mb-1">Assistant</p>
                  <div class="prose prose-sm max-w-none">
                    <%= simple_format(message.content, {}, wrapper_tag: "div") %>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="flex items-start space-x-2">
                <svg class="h-5 w-5 text-white mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                </svg>
                <div class="flex-1">
                  <p class="text-sm font-medium mb-1 opacity-90">You</p>
                  <p class="text-sm"><%= message.content %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Input Form -->
  <div class="bg-white border-t border-gray-200 px-6 py-4">
    <%= form_with url: messages_path, method: :post, local: true, class: "flex space-x-4", data: { turbo: false } do |f| %>
      <%= hidden_field_tag :conversation_id, @conversation.id %>
      <%= f.text_field :content, 
          placeholder: "Ask a question about the application...", 
          autofocus: true,
          class: "flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
          id: "message-input" %>
      <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-medium">
        Send
      </button>
    <% end %>
  </div>
</div>

<script>
  // Auto-scroll to bottom when page loads
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('messages-container');
    if (container) {
      container.scrollTop = container.scrollHeight;
    }
  });

  // Auto-scroll after form submission
  document.addEventListener('submit', function(e) {
    if (e.target.closest('form')) {
      setTimeout(function() {
        const container = document.getElementById('messages-container');
        if (container) {
          container.scrollTop = container.scrollHeight;
        }
      }, 100);
    }
  });
</script>

