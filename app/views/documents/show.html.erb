<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Documents", documents_path, class: "text-blue-600 hover:text-blue-800 mb-4 inline-block" %>
    <h1 class="text-3xl font-bold text-gray-900"><%= @document.title %></h1>
    <div class="mt-2 text-sm text-gray-500">
      Source: <%= @document.source %> | 
      Created: <%= @document.created_at.strftime("%Y-%m-%d %H:%M") %> |
      Chunks: <%= @chunks.count %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-xl font-semibold mb-4">Document Content</h2>
    <div class="prose max-w-none">
      <pre class="whitespace-pre-wrap text-sm"><%= @document.raw_content %></pre>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-xl font-semibold mb-4">Chunks (<%= @chunks.count %>)</h2>
    <div class="space-y-4">
      <% @chunks.each_with_index do |chunk, idx| %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex justify-between items-start mb-2">
            <span class="text-sm font-medium text-gray-500">Chunk <%= idx + 1 %></span>
            <% if chunk.embedding.present? %>
              <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded">Has Embedding</span>
            <% else %>
              <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded">No Embedding</span>
            <% end %>
          </div>
          <p class="text-gray-700"><%= chunk.content %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
